# .env.example — 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올리지 않음)

# 서버
PORT=3000
# CORS 허용 출처 (쉼표로 구분)
ALLOWED_ORIGINS=https://kapae5070.org,https://www.kapae5070.org

# DB (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_NAME=kapae5070
DB_USER=kapae
DB_PASS=

# 관리자 로그인 (프론트엔드 코드에는 더 이상 계정이 없음)
ADMIN_ID=
ADMIN_PASSWORD=
# 관리자 토큰 서명용 비밀값 — 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# 문의 알림 메일 (Gmail 앱 비밀번호)
SMTP_USER=
SMTP_PASS=
RECEIVER_EMAIL=

# AI
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
